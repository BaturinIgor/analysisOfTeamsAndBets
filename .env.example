# Скопируйте этот файл в .env и заполните. Файл .env не попадает в git.

# Telegram (понадобится на этапе 1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=786270397
# Если провайдер режет api.telegram.org: прокси для бота, например socks5://127.0.0.1:1080 или http://127.0.0.1:8080
TELEGRAM_PROXY=

# STRATZ: https://stratz.com/api (вход через Steam)
STRATZ_TOKEN=

# OpenDota: ключ не обязателен, бесплатного лимита хватает
OPENDOTA_API_KEY=

# OddsPapi: ключ из личного кабинета
ODDSPAPI_API_KEY=
ODDSPAPI_BASE_URL=https://api.oddspapi.io/v4
# id рынка «победа в матче» в OddsPapi (узнаём командой bk oddspapi-sample)
ODDSPAPI_WINNER_MARKET=

# OddiWire (линия Oddin.gg, бесплатно 100 запросов в день). Пусто = демо-доступ без ключа.
ODDIWIRE_API_KEY=

# PandaScore (история CS2 и LoL, бесплатно 1000 запросов в час; ключ — pandascore.co → Sign up → токен в кабинете).
# Пусто = CS2 и LoL не собираем и не считаем.
PANDASCORE_TOKEN=
# Какие игры собирать: dota2, cs2, lol через запятую. Пусто = все доступные (Dota собирается всегда).
GAMES=

# Пороги сигнала в боте: перевес (EV) от 3%; ваш фильтр «90% и 1.5» — SIGNAL_MIN_PROB=0.9, SIGNAL_MIN_ODDS=1.5
SIGNAL_MIN_EV=0.03
SIGNAL_MIN_PROB=0
SIGNAL_MIN_ODDS=1.0
# Не ставить, если наша вероятность расходится с рынком (без маржи) больше чем на 10 п.п. — скорее ошибка модели.
# Реальный перевес обычно 2–8 п.п.; такие случаи бот пишет на заметку («аутсайдеры»).
SIGNAL_MAX_GAP=0.10
# Не ставить, если у одной из команд меньше стольких карт в истории: рейтинг ещё не устоялся
SIGNAL_MIN_GAMES=30
TIMEZONE=Europe/Moscow

# Симулятор: стратегии идут параллельно на одних сигналах, у каждой свой банк SIM_BANK.
# fixed — SIM_STAKE за ставку; percent — SIM_PERCENT текущего банка; kelly — доля Келли SIM_KELLY.
# Любая ставка не больше 10% банка.
SIM_BANK=25000
SIM_STRATEGIES=fixed,percent,kelly
SIM_STAKE=1250
SIM_PERCENT=0.07
SIM_KELLY=1.0
# Эксперименты: на тех же коэффициентах параллельно идут другие пороги, у каждого свои банки (те же стратегии).
# Уведомлений по ним нет, итоги — в конце /sim («Сравнение настроек») и в выгрузке.
# Формат: «Имя: ключ=значение ...; Имя2: ...». Ключи: ev, prob (наша вероятность), odds, gap, games.
# Что не указано — как в SIGNAL_*. Пусто — без экспериментов.
SIM_EXPERIMENTS=Фавориты: prob=0.5; Строгий: prob=0.5 ev=0.04 gap=0.06 games=50

# Контакт для User-Agent (Liquipedia требует его указывать). Можно ник или ссылку на репозиторий.
CONTACT=github.com/BaturinIgor/analysisOfTeamsAndBets

# Путь к базе SQLite
DB_PATH=data/bk.sqlite3
