# Скопируйте этот файл в .env и заполните. Файл .env не попадает в git.

# Telegram (понадобится на этапе 1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=786270397

# STRATZ: https://stratz.com/api (вход через Steam)
STRATZ_TOKEN=

# OpenDota: ключ не обязателен, бесплатного лимита хватает
OPENDOTA_API_KEY=

# OddsPapi: ключ из личного кабинета
ODDSPAPI_API_KEY=
ODDSPAPI_BASE_URL=https://api.oddspapi.io/v4
# id рынка «победа в матче» в OddsPapi (узнаём командой bk oddspapi-sample)
ODDSPAPI_WINNER_MARKET=

# OddiWire (линия Oddin.gg, бесплатно 100 запросов в день). Пусто = демо-доступ без ключа.
ODDIWIRE_API_KEY=

# Пороги сигнала в боте: перевес (EV) от 5%; ваш фильтр «90% и 1.5» — SIGNAL_MIN_PROB=0.9, SIGNAL_MIN_ODDS=1.5
SIGNAL_MIN_EV=0.05
SIGNAL_MIN_PROB=0
SIGNAL_MIN_ODDS=1.0
TIMEZONE=Europe/Moscow

# Контакт для User-Agent (Liquipedia требует его указывать). Можно ник или ссылку на репозиторий.
CONTACT=github.com/BaturinIgor/analysisOfTeamsAndBets

# Путь к базе SQLite
DB_PATH=data/bk.sqlite3
